---
import { DEMO_URL } from "@/shared/config";
import { Button } from "@/shared/ui";

/**
 * «Записаться на демо» — главное действие сайта (PLAN.md, «Как устроена заявка»): ссылка на чат с
 * CEO в Telegram с набранным сообщением. Одна точка для шапки, первого экрана и блока «Демо», чтобы
 * подпись, ссылка и поведение не разошлись.
 *
 * Клиентский JS здесь ради магнита: кнопка тянется к курсору (просьба владельца продукта, реф Magnet).
 * Без JS, на телефоне и с prefers-reduced-motion это обычная ссылка.
 */
interface Props {
  variant?: "primary" | "secondary";
  size?: "md" | "lg";
}

const { variant = "primary", size = "lg" } = Astro.props;
---

<Button href={DEMO_URL} variant={variant} size={size} magnet={variant === "primary"}>
  Записаться на демо
  {variant === "primary" && (
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      class="size-[1.1em] fill-none stroke-current stroke-2 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
    >
      <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</Button>

<script>
  import { initMagnet } from "../../model/magnet";

  initMagnet();
</script>
