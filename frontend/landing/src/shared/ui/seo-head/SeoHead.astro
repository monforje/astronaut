---
/**
 * SEO-теги страницы: title, description, canonical и Open Graph. Адрес собирается из `site`
 * (astro.config.ts, `PUBLIC_SITE_URL`) и пути страницы.
 *
 * [TODO] `og:image` 1200×630 — превью ссылки в Telegram и почте, главном канале (PLAN.md, «SEO»):
 * маскот и заголовок «Документы без расхождений» на белом с off-white пятном, в стиле первого
 * экрана. Картинку — в idea/skelet/brand/, ссылкой в brand/public/brand/og.png; здесь — `og:image`
 * абсолютным адресом от `site`, плюс `og:image:width`, `og:image:height` и `og:image:alt`. Пока
 * картинки нет, ссылка в Telegram выглядит голой.
 */
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
