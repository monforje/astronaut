const { shape = "hero", tone = "surface", duration = 22 } = Astro.props;
const [a, b, c] = SHAPES[shape];
const ease = "0.45 0 0.55 1";
---

<svg
  aria-hidden="true"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  class:list={[
    "absolute inset-0 size-full overflow-visible",
    tone === "surface" && "fill-surface",
    tone === "tint" && "fill-tint",
    tone === "bg" && "fill-bg",
  ]}
>
  <path class="still" d={a}></path>
  <path class="live" d={a}>
    <animate
      attributeName="d"
      values={`${a};${b};${c};${a}`}
      dur={`${duration}s`}
      repeatCount="indefinite"
      calcMode="spline"
      keyTimes="0;0.33;0.66;1"
      keySplines={`${ease};${ease};${ease}`}
    ></animate>
  </path>
</svg>

<style>
  .live {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .live {
      display: inline;
    }
    .still {
      display: none;
    }
  }
</style>
