---
/**
 * Цифры, коды и номера внутри обычного текста — Fira Code (DESIGN.md, «Шрифт»): «120 мест»,
 * «MSKU1234567», «18 420 кг». Моно крупнее Onest при том же кегле, поэтому чуть уменьшен; пробел
 * в моно шириной в цифру, поэтому между разрядами он поджат. Знак «№» оставляем снаружи, в Onest:
 * в моно он сжат до нечитаемого.
 *
 * `spark` — значение, которое не сходится с другими документами: оранжевый маркер под ним и
 * «искра внимания» из иллюстраций бренда (три штриха). Глаз сам находит расхождение. Разметка —
 * `<mark>`: это выделение по смыслу, а не украшение. Кроме главной кнопки оранжевый есть только тут.
 */
interface Props {
  variant?: "plain" | "spark";
}

const { variant = "plain" } = Astro.props;
---

{variant === "spark" ? (
  <mark class="relative rounded-[0.3em] bg-spark/35 px-[0.2em] font-mono text-[0.9em] font-medium [word-spacing:-0.3em] whitespace-nowrap text-current">
    <slot />
    <svg
      aria-hidden="true"
      viewBox="0 0 16 16"
      class="absolute -top-[0.85em] -right-[0.8em] size-[0.95em] fill-none stroke-spark stroke-[2.5]"
      stroke-linecap="round"
    >
      <path d="M3.5 10.5 2.5 3M7 11.5l5.5-5M8 14.5l6.5-.5" />
    </svg>
  </mark>
) : (
  <span class="font-mono text-[0.9em] font-medium [word-spacing:-0.3em] whitespace-nowrap">
    <slot />
  </span>
)}
