---
import { Icon } from "@/shared/ui";

/**
 * Три слова под первым экраном, такт 4: «Одна карточка. Сверка до отправки. Сбой виден сразу.»
 * (10-shpargalka.md, раздел 3). Договаривают питч на 10 секунд — лидогенератор говорит по телефону
 * те же слова. Заголовки и тексты — PLAN.md, «2. Три слова». Перед тире — неразрывный пробел.
 *
 * Вид: не три одинаковые карточки с иконкой (шаблон, который читается как сгенерированный), а одна
 * мятная полоса с тремя кусками интерфейса продукта; заголовок и текст лежат под ними на фоне, без
 * рамок и реакций на наведение. Куски сделаны по сквозному примеру и по ходу «Пути контейнера»:
 * карточка груза заполнена из PDF (получатель Ромашка, 120 мест из инвойса, 18 420 кг из
 * упаковочного листа); сверка — на шаге черновика коносамента (инвойс и упаковочный лист сверены,
 * в коносаменте расхождение, декларация и ЭТрН ждут); в обменах упал 1С → Контур, как в чате агента.
 * Оранжевой искры здесь нет: на одном экране с главной кнопкой первого экрана. Куски — картинка для
 * глаза, скрыты от читалки: смысл несут заголовок и текст. На телефоне у каждого куска своя
 * мятная подложка, с `md` подложка одна на ряд.
 */
const FEATURES = [
  {
    kind: "card",
    title: "Одна карточка груза",
    text: "Отправитель, получатель, места, вес и номер контейнера вносятся один раз. Если есть PDF, программа считает его сама.",
  },
  {
    kind: "check",
    title: "Сверка до отправки",
    text: "Инвойс, упаковочный лист, коносамент, декларация и ЭТрН сверяются между собой. Расхождение видно до таможни.",
  },
  {
    kind: "sync",
    title: "Сбой виден сразу",
    text: "Упал обмен между 1С, CRM и кабинетами — ответственный узнаёт в ту же минуту, а не когда позвонит клиент.",
  },
] as const;

const CARD = [
  { label: "Получатель", value: "ООО Ромашка", mono: false },
  { label: "Места", value: "120", mono: true },
  { label: "Вес брутто", value: "18 420 кг", mono: true },
] as const;

const CHECKS = [
  { doc: "Инвойс", state: "ok" },
  { doc: "Упаковочный лист", state: "ok" },
  { doc: "Коносамент", state: "action" },
  { doc: "Декларация", state: "wait" },
  { doc: "ЭТрН", state: "wait" },
] as const;

const EXCHANGES = [
  { route: "1С → Контур", up: false },
  { route: "1С → Битрикс24", up: true },
  { route: "Сайт → 1С", up: true },
] as const;

const panel = "w-full max-w-[17rem] rounded-2xl bg-bg p-4 text-xs shadow-card sm:text-[0.8125rem]";
---

<section
  id="features"
  aria-labelledby="features-title"
  class="page-container scroll-mt-8 pb-14 lg:pb-20"
>
  <h2 id="features-title" class="sr-only">
    Что делает Astronaut
  </h2>
  <div class="relative">
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 hidden h-56 rounded-[2rem] bg-tint md:block"
    ></div>
    <ul data-reveal="group" class="features relative grid gap-10 md:grid-cols-3 md:gap-6 lg:gap-10">
      {FEATURES.map(({ kind, title, text }, i) => (
        <li style={`--i: ${i}`}>
          <div
            aria-hidden="true"
            class="grid h-56 place-items-center rounded-[2rem] bg-tint px-5 md:bg-transparent"
          >
            {kind === "card" && (
              <div class={panel}>
                <div class="flex items-center justify-between gap-2">
                  <span class="flex items-center gap-1.5 font-mono font-semibold">
                    <span class="text-accent-strong">
                      <Icon name="box" size="sm" />
                    </span>
                    MSKU1234567
                  </span>
                  <span class="row flex items-center gap-1 rounded-full bg-tint px-2 py-0.5 font-semibold text-accent-strong">
                    <Icon name="document" size="sm" />
                    из PDF
                  </span>
                </div>
                <dl class="mt-3.5 space-y-2.5">
                  {CARD.map(({ label, value, mono }, r) => (
                    <div
                      class="row flex items-baseline justify-between gap-3"
                      style={`--r: ${r + 1}`}
                    >
                      <dt class="text-muted">{label}</dt>
                      <dd class:list={["font-semibold", mono && "font-mono"]}>{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {kind === "check" && (
              <div class={panel}>
                <span class="font-semibold">Сверка документов</span>
                <ul class="mt-3 space-y-2">
                  {CHECKS.map(({ doc, state }, r) => (
                    <li
                      class:list={[
                        "row flex items-center justify-between gap-3",
                        state === "wait" && "text-muted",
                      ]}
                      style={`--r: ${r}`}
                    >
                      <span class="flex items-center gap-2">
                        {state === "ok" && (
                          <span class="grid size-4 place-items-center rounded-full bg-accent text-accent-contrast">
                            <Icon name="check" size="sm" />
                          </span>
                        )}
                        {state === "action" && (
                          <span class="relative grid size-4 place-items-center">
                            <span class="absolute inset-0.5 rounded-full bg-accent motion-safe:animate-ping-soft" />
                            <span class="relative size-3 rounded-full border-2 border-accent-strong bg-bg" />
                          </span>
                        )}
                        {state === "wait" && (
                          <span class="grid size-4 place-items-center">
                            <span class="size-3 rounded-full border-2 border-line" />
                          </span>
                        )}
                        {doc}
                      </span>
                      {state === "action" && (
                        <span class="font-semibold text-accent-strong">расхождение</span>
                      )}
                      {state === "wait" && <span>ждёт</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {kind === "sync" && (
              <div class={panel}>
                <span class="font-semibold">Обмены</span>
                <ul class="mt-3 space-y-2.5">
                  {EXCHANGES.map(({ route, up }, r) => (
                    <li class="row flex items-center justify-between gap-3" style={`--r: ${r}`}>
                      <span>{route}</span>
                      <span
                        class:list={[
                          "flex items-center gap-1.5",
                          up ? "text-muted" : "font-semibold",
                        ]}
                      >
                        {up ? (
                          <span class="size-2 rounded-full bg-accent" />
                        ) : (
                          <span class="relative grid size-2.5 place-items-center">
                            <span class="absolute inset-0 rounded-full bg-accent motion-safe:animate-ping-soft" />
                            <span class="relative size-2.5 rounded-full border-2 border-accent-strong bg-bg" />
                          </span>
                        )}
                        {up ? "работает" : "не работает"}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <h3 class="mt-5 text-lg leading-tight font-bold text-balance lg:text-xl">{title}</h3>
          <p class="mt-1.5 max-w-sm text-[0.9375rem] text-muted">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .features:not([data-inview]) .row {
      opacity: 0;
    }
    :global(.js) .features[data-inview] .row {
      animation: row-in 0.5s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 110ms + 400ms + var(--r, 0) * 130ms);
    }
  }
  @keyframes row-in {
    from {
      opacity: 0;
      translate: 0 0.35rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
