---
/**
 * Четыре ценности под первым экраном — заголовки и подзаголовки из phrases.md («Ценность по
 * предложениям»). Перед тире — неразрывный пробел: тире не уезжает в начало строки.
 */
const FEATURES = [
  {
    icon: "documents",
    title: "Документы без расхождений",
    text: "Инвойс, коносамент, декларация и ЭТрН сверяются по одной карточке груза до отправки.",
  },
  {
    icon: "status",
    title: "Где контейнер\u00a0— видно сразу",
    text: "Море, железная дорога и Владивосток в одной ленте, уведомления в Telegram.",
  },
  {
    icon: "exchanges",
    title: "Обмены, которые не ломаются молча",
    text: "1С, CRM, сайт и кабинеты связаны, о сбое\u00a0— сообщение в ту же минуту.",
  },
  {
    icon: "directory",
    title: "Одна Ромашка вместо трёх",
    text: "Клиенты, перевозчики и поставщики\u00a0— один справочник на все системы, с проверкой по ЕГРЮЛ и ГосЛогу.",
  },
] as const;
---

<section
  id="features"
  aria-labelledby="features-title"
  class="mx-auto max-w-7xl scroll-mt-8 px-4 pb-16 md:px-8 lg:pb-24"
>
  <h2 id="features-title" class="sr-only">
    Что делает Astronaut
  </h2>
  <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    {FEATURES.map(({ icon, title, text }) => (
      <li>
        <span class="flex size-20 items-center justify-center rounded-full bg-surface">
          <svg
            aria-hidden="true"
            viewBox="0 0 48 48"
            class="size-12 fill-none stroke-navy"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {icon === "documents" && (
              <>
                <path d="M12 5h15l9 9v23a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
                <path d="M27 5v9h9M16 20h12M16 26h9M16 32h5" />
                <circle cx="35" cy="36" r="8.5" class="fill-teal stroke-bg" />
                <path d="M31 36l3 3 5-5.5" class="stroke-bg" />
              </>
            )}
            {icon === "status" && (
              <>
                <ellipse cx="24" cy="40" rx="13" ry="4" class="fill-teal stroke-none" />
                <path
                  d="M24 40S12.5 29.5 12.5 20.5a11.5 11.5 0 0 1 23 0C35.5 29.5 24 40 24 40Z"
                  class="fill-navy"
                />
                <circle cx="24" cy="20.5" r="4.5" class="fill-bg stroke-none" />
              </>
            )}
            {icon === "exchanges" && (
              <>
                <g stroke-width="4">
                  <path d="M38 21A14.5 14.5 0 0 0 11.5 15" />
                  <path d="M10 26a14.5 14.5 0 0 0 26.5 7" class="stroke-teal" />
                </g>
                <path d="M10 7.5V16h8.5" stroke-width="4" />
                <path d="M38 40.5V32h-8.5" stroke-width="4" class="stroke-teal" />
              </>
            )}
            {icon === "directory" && (
              <>
                <path
                  d="M8 11v24c0 2.8 5.8 5 13 5s13-2.2 13-5V11c0 2.8-5.8 5-13 5S8 13.8 8 11Z"
                  class="fill-navy"
                />
                <ellipse cx="21" cy="11" rx="13" ry="5" class="fill-navy" />
                <path
                  d="M8 19c0 2.8 5.8 5 13 5s13-2.2 13-5M8 27c0 2.8 5.8 5 13 5"
                  class="stroke-bg"
                />
                <circle cx="35" cy="36" r="8.5" class="fill-teal stroke-bg" />
                <path d="M31 36l3 3 5-5.5" class="stroke-bg" />
              </>
            )}
          </svg>
        </span>
        <h3 class="mt-5 text-xl leading-tight font-bold text-balance">{title}</h3>
        <p class="mt-2 text-muted">{text}</p>
      </li>
    ))}
  </ul>
</section>
