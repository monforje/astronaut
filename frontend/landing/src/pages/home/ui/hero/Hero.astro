---
import { Image } from "astro:assets";
import { DemoButton } from "@/features/request-demo";
import { astronautPort } from "@/shared/brand";
import { Blob, Button, SplitText } from "@/shared/ui";

/**
 * Первый экран, такт 4 и кнопка такта 8 (story.md). Заголовок — ценность «А. Документы»,
 * подзаголовок — «одно предложение» о компании (phrases.md). Кнопки — первый экран из cta.md:
 * «Записаться на демо» открывает Telegram, «Как это работает» ведёт к пути контейнера (#how).
 *
 * Движение первого экрана: заголовок по буквам (SplitText), подзаголовок и кнопки следом,
 * пятно за иллюстрацией дышит, две звёздочки мерцают. Сама иллюстрация неподвижна (парение
 * убрано 03.11.2026). Всё под prefers-reduced-motion.
 */
const STARS = [
  { at: "top-[6%] left-[8%]", delay: "0s", size: "size-4" },
  { at: "bottom-[18%] right-[2%]", delay: "1.4s", size: "size-3" },
] as const;
---

<section id="top" aria-labelledby="hero-title" class="relative isolate scroll-mt-8">
  <div class="pointer-events-none absolute right-0 bottom-0 -z-10 h-[46%] w-[115%] translate-x-[8%] lg:-top-28 lg:bottom-auto lg:h-[calc(100%+5rem)] lg:w-[58%] lg:translate-x-[12%]">
    <Blob shape="hero" duration={24} />
  </div>

  <div class="page-container grid items-center gap-8 pt-6 pb-10 lg:grid-cols-[1fr_1fr] lg:gap-6 lg:pt-10 lg:pb-14">
    <div class="relative z-10">
      <h1
        id="hero-title"
        class="text-[2.5rem] leading-[0.98] font-extrabold tracking-tight sm:text-5xl lg:-mr-24 lg:text-[3.5rem] xl:text-[4rem] 2xl:text-[4.75rem]"
      >
        <span class="block">
          <SplitText text="Документы" />
        </span>{" "}
        <span class="block">
          <SplitText text="без расхождений" delay={300} />
        </span>
      </h1>
      <p class="mt-5 max-w-xl text-base text-muted md:text-lg lg:mt-6 2xl:text-xl motion-safe:animate-rise motion-safe:[animation-delay:700ms]">
        Astronaut связывает 1С, CRM, операторов ЭПД и таможенное ПО, чтобы данные о грузе были
        одинаковыми во всех документах и системах.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-2 lg:mt-8 motion-safe:animate-rise motion-safe:[animation-delay:850ms]">
        <DemoButton />
        <Button href="#how" variant="link" size="lg">
          Как это работает
        </Button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
      {STARS.map(({ at, delay, size }) => (
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class:list={["absolute fill-text motion-safe:animate-twinkle", at, size]}
          style={`animation-delay: ${delay}`}
        >
          <path d="M12 0c.8 6.4 5.6 11.2 12 12-6.4.8-11.2 5.6-12 12-.8-6.4-5.6-11.2-12-12C6.4 11.2 11.2 6.4 12 0z" />
        </svg>
      ))}
      <Image
        src={astronautPort}
        alt=""
        widths={[480, 800, 1200, 1634]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full"
      />
    </div>
  </div>
</section>
