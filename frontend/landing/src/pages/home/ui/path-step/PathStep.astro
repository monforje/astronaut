---
import { SystemMessage } from "../system-message";

/**
 * Шаг пути контейнера (секция «Путь одного контейнера»): номер на маршруте, что делает менеджер и
 * что ему пишет система (слот — текст `SystemMessage`, `source` и `status` — её шапка и точка).
 *
 * Маршрут (реф: дорожная карта): кружки-номера с teal-обводкой, между ними тонкая линия. Шаг и его
 * сообщение стоят в одной строке сетки, поэтому связь видна без выносок: линии к карточкам убрали,
 * они спорили с маршрутом. Номер для глаза, порядок читалке даёт `<ol>`. Маршрут с номерами —
 * только здесь, на сердце страницы.
 */
interface Props {
  n: number;
  title: string;
  text: string;
  source: string;
  status?: "ok" | "action";
  last?: boolean;
}

const { n, title, text, source, status = "ok", last = false } = Astro.props;
---

<li
  style={`--i: ${n - 1}`}
  class="step relative grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 lg:grid-cols-[2.75rem_minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start lg:gap-x-6"
>
  {!last && (
    <span
      aria-hidden="true"
      class="route absolute top-10 -bottom-5 left-[calc(1.25rem-1px)] w-0.5 rounded-full bg-accent/45 lg:top-11 lg:-bottom-4 lg:left-[calc(1.375rem-1px)]"
    />
  )}
  <span
    aria-hidden="true"
    class="dot relative grid size-10 place-items-center rounded-full border-2 border-accent bg-bg text-[0.9375rem] font-bold text-accent-strong lg:size-11"
  >
    {n}
  </span>
  <div class="pt-1.5 lg:pt-2">
    <h3 class="text-base leading-tight font-bold lg:text-lg">{title}</h3>
    <p class="mt-1 text-[0.9375rem] text-muted">{text}</p>
  </div>
  <div class="col-start-2 mt-3 lg:col-start-3 lg:mt-0">
    <SystemMessage source={source} status={status}>
      <slot />
    </SystemMessage>
  </div>
</li>
