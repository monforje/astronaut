{
  "name": "demo-site-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc",
    "lint": "oxlint && bun run lint:fsd && bun run lint:style",
    "lint:fsd": "steiger src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --config testing/playwright.config.ts",
    "verify": "bun run check && bun run lint && bun run format:check && bun run test",
    "api:gen": "orval --config orval.config.ts",
    "lint:style": "vitest run docs/codestyle"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^8.4.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "happy-dom": "^20.14.6",
    "msw": "^3.0.3",
    "orval": "^8.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "steiger": "^0.7.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  }
}
