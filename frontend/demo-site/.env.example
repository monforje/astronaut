APP_HOSTNAME=demo.astronaut.localhost

# Бэкенд, с которым работает фронт: каталог в backend/. Из backend/${BACKEND} берётся контракт
# (schema/openapi/openapi.yaml → task gen-api), к ${BACKEND}-http:8080 vite проксирует /api/v1.
# Пока бэкенда нет, контракт — contract/openapi.yaml, а запросы обслуживают моки (VITE_API_MOCK).
# Хост у фронта и бэкенда общий (APP_HOSTNAME): cookie сессии и проверка Origin — same-origin.
BACKEND=astronaut

VITE_API_BASE_URL=

# Моки API в браузере (MSW, mocks/): true — фронт работает без бэкенда, данные в localStorage.
# Появится бэкенд — false.
VITE_API_MOCK=true
