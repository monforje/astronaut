{
  "name": "@astronaut/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "UI-кит Astronaut: React-компоненты, токены и стили (используется внутри монорепо, в реестры не публикуется)",
  "license": "UNLICENSED",
  "author": "Komarov Zhiznev Group",
  "files": [
    "dist-lib",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./tokens.css": "./dist-lib/tokens.css",
    "./assets/*": "./dist-lib/assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "verify": "bun run check && bun run lint && bun run format:check && bun run test",
    "docs": "bun scripts/gen-docs.ts",
    "mcp": "bun mcp/main.ts",
    "lib:build": "vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode tokens && tsc -p tsconfig.lib.json && bun scripts/lib-finish.ts",
    "lib:smoke": "bun scripts/smoke-consumer.ts",
    "lib:verify": "bun scripts/check-lib.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^8.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
